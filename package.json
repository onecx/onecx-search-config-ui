{
  "name": "onecx-search-config-ui",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "contributors": [
    "OneCX Development Team <onecx_dev@1000kit.org>"
  ],
  "config": {
    "openapiYaml": "src/assets/api/openapi-bff.yaml",
    "openapiOutput": "src/app/shared/generated"
  },
  "scripts": {
    "apigen-cleanup": "rm -rf $npm_package_config_openapiOutput",
    "apigen-format": "npx prettier $npm_package_config_openapiYaml --write && npx prettier $npm_package_config_openapiOutput/**/* --write",
    "apigen-generate": "openapi-generator-cli generate -i $npm_package_config_openapiYaml -g typescript-angular -c apigen.yaml -o $npm_package_config_openapiOutput --type-mappings=AnyType=object,set=Array",
    "apigen": "npm run apigen-cleanup && npm run apigen-generate && npm run apigen-format",
    "start": "nx serve --host 0.0.0.0 --disable-host-check",
    "build": "nx build",
    "postbuild": "mv \"$(find dist/onecx-search-config-ui -maxdepth 1 -type f -name 'styles.*.css' | head -n 1)\" dist/onecx-search-config-ui/styles.css",
    "clean": "npm cache clean --force && nx reset && rm -rf *.log dist reports .angular .eslintcache ./node_modules/.cache/prettier/.prettier-cache",
    "lint": "nx lint --cache=true && npx prettier -c --cache .",
    "lint-fix": "npx prettier --write .",
    "eslint": "eslint --quiet --ext .js,.ts src",
    "format": "nx lint --fix && npx prettier --write .",
    "audit": "npm audit --audit-level=high",
    "browser": "npx browserslist",
    "prepare": "husky || true",
    "test": "nx test",
    "test:ci": "nx test --watch=false --browsers=ChromeHeadless --coverage",
    "sonar": "npx sonarqube-scanner -Dproject.settings=sonar-local-project.properties"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "dependencies": {
    "@angular-architects/module-federation": "^19.0.3",
    "@angular/animations": "^19.2.25",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.25",
    "@angular/compiler": "^19.2.25",
    "@angular/core": "^19.2.25",
    "@angular/elements": "^19.2.25",
    "@angular/forms": "^19.2.25",
    "@angular/platform-browser": "^19.2.25",
    "@angular/platform-browser-dynamic": "^19.2.25",
    "@angular/router": "^19.2.25",
    "@ngneat/error-tailor": "^5.0.1",
    "@ngrx/component-store": "^19.2.1",
    "@ngrx/effects": "^19.2.1",
    "@ngrx/router-store": "^19.2.1",
    "@ngrx/store": "^19.2.1",
    "@ngrx/store-devtools": "^19.2.1",
    "@ngx-translate/core": "^16.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@onecx/accelerator": "^6.27.1",
    "@onecx/angular-accelerator": "^6.27.1",
    "@onecx/angular-auth": "^6.27.1",
    "@onecx/angular-integration-interface": "^6.27.1",
    "@onecx/angular-remote-components": "^6.27.1",
    "@onecx/angular-utils": "^6.27.1",
    "@onecx/angular-webcomponents": "^6.27.1",
    "@onecx/nx-plugin": "^6.0.0",
    "@onecx/angular-testing": "^6.24.1",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "keycloak-js": "^25.0.6",
    "fast-deep-equal": "3.1.3",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^19.0.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.3",
    "zod": "^3.23.8",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.25",
    "@angular-devkit/core": "^19.2.25",
    "@angular-devkit/schematics": "^19.2.25",
    "@angular-eslint/eslint-plugin": "^19.2.22",
    "@angular-eslint/eslint-plugin-template": "^19.2.22",
    "@angular-eslint/template-parser": "^19.2.22",
    "@angular/cli": "^19.2.25",
    "@angular/compiler-cli": "^19.2.25",
    "@angular/language-service": "^19.2.25",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.5.0",
    "@nx/angular": "20.5.0",
    "@nx/eslint": "20.5.0",
    "@nx/eslint-plugin": "20.5.0",
    "@nx/jest": "20.5.0",
    "@nx/js": "20.5.0",
    "@nx/workspace": "20.5.0",
    "@openapitools/openapi-generator-cli": "^2.13.4",
    "@schematics/angular": "^19.2.22",
    "@swc-node/register": "~1.10.9",
    "@swc/core": "~1.7.3",
    "@swc/helpers": "~0.5.12",
    "@types/jest": "^29.5.12",
    "@types/node": "22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "~8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "husky": "^9.1.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-marbles": "^3.1.0",
    "jest-preset-angular": "~14.4.2",
    "jest-sonar": "^0.2.16",
    "jest-sonar-reporter": "^2.0.0",
    "js-yaml": "^4.1.0",
    "jsonc-eslint-parser": "^2.4.0",
    "modify-source-webpack-plugin": "^4.1.0",
    "ngx-translate-testing": "^7.0.0",
    "nx": "20.5.0",
    "prettier": "^3.3.3",
    "sonarqube-scanner": "^4.3.2",
    "ts-jest": "^29.2.3",
    "ts-node": "10.9.2",
    "typescript": "~5.5"
  }
}
