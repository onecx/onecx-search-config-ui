    "@swc-node/register": "~1.10.9",
    "@swc/core": "~1.7.3",
    "@swc/helpers": "~0.5.12",
    "@types/jest": "^29.5.12",
    "@types/node": "22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "~8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "husky": "^9.1.4",
    "jest": "^29.7.0",
